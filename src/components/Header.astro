---
const navLinks = [
  { href: '/categories/preparation', label: 'Preparedness' },
  { href: '/categories/equipement',  label: 'Equipment' },
  { href: '/categories/habitat',     label: 'Shelter' },
  { href: '/categories/sante',       label: 'Health' },
  { href: '/boutique',               label: 'Shop' },
];
const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <img src="/images/logo-family-ready-now.png" alt="Family Ready Now" class="logo-img" />
    </a>

    <nav class="main-nav">
      {navLinks.map(link => (
        <a href={link.href} class:list={['nav-link', { active: currentPath.startsWith(link.href) }]}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-cta">
      <a href="/newsletter" class="btn btn--outline" style="font-size:0.75rem;padding:0.5rem 1.25rem;">
        Join Free
      </a>
    </div>

    <button class="menu-toggle" id="menuToggle" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    {navLinks.map(link => (
      <a href={link.href} class="mobile-nav-link">{link.label}</a>
    ))}
    <a href="/newsletter" class="btn btn--primary" style="margin:1rem 1.5rem;">Join Family Ready Now</a>
  </div>
</header>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(10, 12, 11, 0.97);
  border-bottom: 1px solid var(--border-subtle);
  backdrop-filter: blur(8px);
}
.header-inner {
  display: flex;
  align-items: center;
  gap: 2rem;
  height: 64px;
}
.logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  flex-shrink: 0;
}
.logo-img {
  height: 44px;
  width: auto;
  display: block;
  border-radius: 6px;
}
.main-nav {
  display: flex;
  gap: 0.25rem;
  margin-left: auto;
}
.nav-link {
  font-family: var(--font-sub);
  font-size: 0.78rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-secondary);
  padding: 0.4rem 0.75rem;
  border-radius: 2px;
  transition: color 0.15s, background 0.15s;
  text-decoration: none;
}
.nav-link:hover, .nav-link.active {
  color: var(--text-primary);
  background: var(--border-subtle);
}
.menu-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.5rem;
  margin-left: auto;
}
.menu-toggle span {
  display: block;
  width: 22px;
  height: 1.5px;
  background: var(--text-primary);
}
.mobile-menu {
  display: none;
  flex-direction: column;
  border-top: 1px solid var(--border-subtle);
  padding: 1rem 0;
}
.mobile-menu.open { display: flex; }
.mobile-nav-link {
  font-family: var(--font-sub);
  font-size: 0.85rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-secondary);
  padding: 0.75rem 1.5rem;
  text-decoration: none;
}
.mobile-nav-link:hover { color: var(--text-primary); background: var(--border-subtle); }
@media (max-width: 768px) {
  .main-nav, .header-cta { display: none; }
  .menu-toggle { display: flex; }
}
</style>

<script>
  const toggle = document.getElementById('menuToggle');
  const menu = document.getElementById('mobileMenu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('open'));
</script>
