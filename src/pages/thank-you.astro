---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Thank You! — Family Ready Now">
  <section style="min-height:60vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:3rem 1.5rem;">
    <div>
      <div style="font-size:3rem;margin-bottom:1rem;">✅</div>
      <h1 style="font-size:2rem;margin-bottom:1rem;">Welcome to the community!</h1>
      <p style="font-size:1.1rem;color:var(--text-muted);max-width:480px;margin:0 auto 2rem;">
        You'll receive our practical tips to help your family prepare with confidence.<br>
        Check your spam folder if you don't see our email within a few minutes.
      </p>
      <a href="/" style="display:inline-block;padding:0.75rem 2rem;background:var(--accent);color:#fff;border-radius:8px;text-decoration:none;font-weight:600;">
        ← Back to home
      </a>
    </div>
  </section>
</Layout>
